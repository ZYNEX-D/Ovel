# Copy to .env.local and replace the placeholders. Do not put real keys in this file.
# Clerk stays off while the publishable key contains "placeholder" or does not start with pk_.

# Clerk publishable key. Read by middleware, ClerkProviderWrapper, clerk-api, login, and signup.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Server key read by @clerk/nextjs when clerkMiddleware, auth(), or currentUser() runs.
CLERK_SECRET_KEY=sk_test_placeholder

# Verified Clerk email that getWorkspaceProfile() treats as super_admin.
DEVELOPER_SUPER_ADMIN_EMAIL=you@example.com

# Supabase client in src/lib/supabase.ts. URL falls back to a value in that file when unset.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Read by src/middleware.ts for Clerk clock skew. Next.js sets this; leave it unset in .env.local.
NODE_ENV=development
